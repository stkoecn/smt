{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMT Task Manager",
  "version": "1.0.0-pre",
  "identifier": "com.smt.taskmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SMT Task Manager",
        "width": 1080,
        "height": 680,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
